# ============================================================
# تنظیمات محیطی سیستم صرافی
# کپی کنید به .env و مقادیر را تغییر دهید
# ============================================================

# پورت اجرا
SARRAFI_PORT=8000

# --- دیتابیس ---
# حالت پیش‌فرض: SQLite (بدون نیاز به تنظیم)
# SARRAFI_DB=/path/to/sarrafi.db
#
# حالت تولید: PostgreSQL
# SARRAFI_DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- امنیت ---
# 1 = احراز هویت اجباری (بدون حالت دمو)
SARRAFI_AUTH_REQUIRED=0

# --- OCR ---
# (اختیاری) کلید API سرویس آنلاین OCR برای مواقعی که tesseract محلی نصب نیست
# SARRAFI_OCR_API_KEY=your-key

# --- نرخ آنلاین ---
# (اختیاری) کلید API «نوسان» (navasan.tech) — اولویت بر کلید ذخیره‌شده در تنظیمات.
# دریافت رایگان از ربات تلگرام @navasan_contact_bot
# SARRAFI_NAVASAN_KEY=your-key

# --- بکاپ خودکار ---
# فاصله‌ی زمانی بکاپ خودکار (ساعت). 0 = غیرفعال
SARRAFI_BACKUP_HOURS=24
